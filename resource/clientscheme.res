#base "clientscheme_base.res"
"Scheme"
{
    "BaseSettings"
    {
        // Source-backed experiment: YRES(480) is the screen height.
        // An empty, borderless native menu should permit bottom anchoring.
        "Main.Menu.X" "0"
        "Main.Menu.Y" "480"
        "Main.BottomBorder" "0"
        "Main.Title1.Color" "255 255 255 0"
        "Main.Title2.Color" "255 255 255 0"
        "Main.Title3.Color" "255 255 255 0"
    }
}
